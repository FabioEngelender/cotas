rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Global Safety Net - Default Deny-All
    match /{document=**} {
      allow read, write: if false;
    }
    
    // Global Security Helper Functions
    function isSignedIn() {
      return request.auth != null;
    }
    
    function isMasterAdmin() {
      return isSignedIn() && request.auth.token.email == 'gamerengelender@gmail.com';
    }

    function isAuthUserOfTenant(tenantId) {
      return isSignedIn() && (
        isMasterAdmin() ||
        exists(/databases/$(database)/documents/tenants/$(tenantId)/users/$(request.auth.uid)) ||
        get(/databases/$(database)/documents/tenants/$(tenantId)).data.owner_id == request.auth.uid
      );
    }
    
    function getUserRole(tenantId) {
      return get(/databases/$(database)/documents/tenants/$(tenantId)/users/$(request.auth.uid)).data.role;
    }
    
    function isAdmin(tenantId) {
      return isSignedIn() && (
        isMasterAdmin() ||
        get(/databases/$(database)/documents/tenants/$(tenantId)).data.owner_id == request.auth.uid ||
        (exists(/databases/$(database)/documents/tenants/$(tenantId)/users/$(request.auth.uid)) && getUserRole(tenantId) == 'admin')
      );
    }
    
    function isManager(tenantId) {
      return isSignedIn() && 
             exists(/databases/$(database)/documents/tenants/$(tenantId)/users/$(request.auth.uid)) && 
             getUserRole(tenantId) == 'manager';
    }
    
    function isClient(tenantId) {
      return isSignedIn() && 
             exists(/databases/$(database)/documents/tenants/$(tenantId)/users/$(request.auth.uid)) && 
             getUserRole(tenantId) == 'client';
    }

    // Match rules for Tenants
    match /tenants/{tenantId} {
      allow get: if (request.auth == null && resource.data.status == 'active') || isAuthUserOfTenant(tenantId) || isMasterAdmin();
      allow list: if (resource.data.status == 'active') || isMasterAdmin();
      allow create: if isSignedIn() && request.resource.data.owner_id == request.auth.uid;
      allow update: if isAdmin(tenantId);
      allow delete: if false;
      
      // Tenant-specific business configurations
      match /settings/{settingKey} {
        allow read: if isAuthUserOfTenant(tenantId);
        allow write: if isAdmin(tenantId);
      }
      
      // Tenant User Identities & PII Boundaries (Zero PII leaks)
      match /users/{userId} {
        allow read: if isSignedIn() && (
          request.auth.uid == userId || 
          isMasterAdmin() || 
          (isAuthUserOfTenant(tenantId) && (isAdmin(tenantId) || isManager(tenantId)))
        );
        allow create: if (
          request.auth.uid == userId && (
            // If they are creating a user with client/manager roles, enforce that they provide a valid invite token matching the role and assigned UID
            ((request.resource.data.role == 'client' || request.resource.data.role == 'manager') &&
             request.resource.data.invite_id != null &&
             getAfter(/databases/$(database)/documents/tenants/$(tenantId)/invites/$(request.resource.data.invite_id)).data.used_by == request.auth.uid &&
             getAfter(/databases/$(database)/documents/tenants/$(tenantId)/invites/$(request.resource.data.invite_id)).data.role == request.resource.data.role) ||
            // Or admin role specifically verified against store owner
            (request.resource.data.role == 'admin' && get(/databases/$(database)/documents/tenants/$(tenantId)).data.owner_id == request.auth.uid)
          )
        ) || isAdmin(tenantId);
        allow update: if isAuthUserOfTenant(tenantId) && (
          (request.auth.uid == userId && 
           request.resource.data.role == resource.data.role && 
           request.resource.data.email == resource.data.email &&
           request.resource.data.tenant_id == resource.data.tenant_id) || 
          isAdmin(tenantId)
        );
        allow delete: if isAdmin(tenantId);
      }
      
      // Products catalog rules
      match /products/{productId} {
        allow read: if isAuthUserOfTenant(tenantId) && (isAdmin(tenantId) || isManager(tenantId) || resource.data.status != 'draft');
        allow create: if isAdmin(tenantId);
        allow update: if isAdmin(tenantId);
        allow delete: if isAdmin(tenantId);
        
        // Product Chat Subcollection (Strictly isolated by tenant + product)
        match /chat/{messageId} {
          allow read: if isAuthUserOfTenant(tenantId);
          allow create: if isAuthUserOfTenant(tenantId) && request.resource.data.user_id == request.auth.uid;
          allow update: if isAuthUserOfTenant(tenantId) && resource.data.user_id == request.auth.uid;
          allow delete: if isAdmin(tenantId);
        }
      }
      
      // Fractional Quotas allocation rules
      match /quotas/{quotaId} {
        allow read: if isAdmin(tenantId) || isManager(tenantId) || (isClient(tenantId) && (resource.data.status == 'available' || resource.data.owner_id == request.auth.uid));
        allow create: if isAdmin(tenantId);
        allow update: if isAdmin(tenantId) || (
          isClient(tenantId) && (
            // Guard 1: Client/Customer reserves a quota for themselves
            (resource.data.status == 'available' && request.resource.data.status == 'reserved' && request.resource.data.reserved_by == request.auth.uid) ||
            // Guard 2: Client/Customer buys directly
            (resource.data.status == 'available' && request.resource.data.status == 'sold' && request.resource.data.owner_id == request.auth.uid) ||
            // Guard 3: Client/Customer buys their reserved quota
            (resource.data.status == 'reserved' && resource.data.reserved_by == request.auth.uid && request.resource.data.status == 'sold' && request.resource.data.owner_id == request.auth.uid)
          )
        );
        allow delete: if isAdmin(tenantId);
        
        // Cohort History
        match /ownership_history/{historyId} {
          allow read: if isAdmin(tenantId) || isManager(tenantId) || (isClient(tenantId) && get(/databases/$(database)/documents/tenants/$(tenantId)/quotas/$(quotaId)).data.owner_id == request.auth.uid);
          allow create, update, delete: if isAdmin(tenantId);
        }
      }
      
      // Ledger / Installments allocation (Financial Gatekeepers)
      match /installments/{installmentId} {
        allow read: if isAdmin(tenantId) || isManager(tenantId) || (isClient(tenantId) && resource.data.owner_id == request.auth.uid);
        allow create: if isAdmin(tenantId) || (isClient(tenantId) && request.resource.data.owner_id == request.auth.uid);
        // Only Admin can record refunds or cancellations. Managers are restricted to manual checkouts (status: paid).
        allow update: if isAdmin(tenantId) || (
          isManager(tenantId) && 
          request.resource.data.status != 'refund' && 
          request.resource.data.status != 'cancelled'
        );
        allow delete: if isAdmin(tenantId);
      }
      
      // Operational Action logs (System actions are Append-only)
      match /audit_logs/{logId} {
        allow read: if isAdmin(tenantId);
        allow create: if isAuthUserOfTenant(tenantId);
        allow update, delete: if false; // Log entries are completely immutable
      }
      
      // Regulatory term agreements and digital contracts
      match /terms/{termId} {
        allow read: if isAuthUserOfTenant(tenantId);
        allow write: if isAdmin(tenantId);
      }
      
      // Immutable Signatures
      match /signatures/{signatureId} {
        allow read: if isAdmin(tenantId) || isManager(tenantId) || (isClient(tenantId) && resource.data.user_id == request.auth.uid);
        allow create: if isAdmin(tenantId) || (isClient(tenantId) && request.resource.data.user_id == request.auth.uid);
        allow update, delete: if false;
      }
      
      // Internal system snapshots for pool conclusions
      match /closing_snapshots/{snapshotId} {
        allow read: if isAdmin(tenantId) || isManager(tenantId);
        allow create: if isAdmin(tenantId) || isManager(tenantId);
        allow update, delete: if false;
      }
      
      // Secure Invitation Tokens (Used for single-redeem registrations)
      match /invites/{inviteId} {
        allow get: if isAdmin(tenantId) || 
                       (isAuthUserOfTenant(tenantId) && resource.data.created_by == request.auth.uid) || 
                       (!isAuthUserOfTenant(tenantId) && resource.data.used == false && resource.data.used_at == null);
        allow list: if isAdmin(tenantId) || 
                        (isAuthUserOfTenant(tenantId) && resource.data.created_by == request.auth.uid);
        allow create: if isAuthUserOfTenant(tenantId) && (
          // Admin can invite manager or client
          (isAdmin(tenantId) && (request.resource.data.role == 'manager' || request.resource.data.role == 'client')) ||
          // Manager can ONLY invite client
          (isManager(tenantId) && request.resource.data.role == 'client') ||
          // Client can ONLY invite client
          (isClient(tenantId) && request.resource.data.role == 'client')
        ) && request.resource.data.created_by == request.auth.uid 
          && request.resource.data.tenant_id == tenantId;
        allow update: if isAdmin(tenantId) || (
          // Allow registration consumption
          isSignedIn() && 
          request.resource.data.role == resource.data.role &&
          request.resource.data.tenant_id == resource.data.tenant_id &&
          request.resource.data.created_by == resource.data.created_by &&
          request.resource.data.expires_at == resource.data.expires_at &&
          (
            request.resource.data.used == true &&
            (request.resource.data.used_by == request.auth.uid || request.resource.data.usedBy == request.auth.uid) &&
            (request.resource.data.used_at != null || request.resource.data.usedAt != null)
          )
        );
        allow delete: if isAdmin(tenantId);
      }
    }
  }
}
