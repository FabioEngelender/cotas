rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Global Safety Net
    match /{document=**} {
      allow read, write: if false;
    }
    
    // Helpers
    function isSignedIn() {
      return request.auth != null;
    }
    
    function getUserData(tenantId, userId) {
      return get(/databases/$(database)/documents/tenants/$(tenantId)/users/$(userId)).data;
    }

    function isAuthUserOfTenant(tenantId) {
      return isSignedIn() && exists(/databases/$(database)/documents/tenants/$(tenantId)/users/$(request.auth.uid));
    }
    
    function getUserRole(tenantId) {
      return getUserData(tenantId, request.auth.uid).role;
    }
    
    function isAdmin(tenantId) {
      return isAuthUserOfTenant(tenantId) && getUserRole(tenantId) == 'admin';
    }
    
    function isManager(tenantId) {
      return isAuthUserOfTenant(tenantId) && getUserRole(tenantId) == 'manager';
    }
    
    function isClient(tenantId) {
      return isAuthUserOfTenant(tenantId) && getUserRole(tenantId) == 'client';
    }

    // Match rules for Tenants
    match /tenants/{tenantId} {
      allow read: if true;
      allow create: if true;
      allow update: if true;
      
      // Settings
      match /settings/{settingKey} {
        allow read: if true;
        allow write: if isSignedIn();
      }
      
      // Users
      match /users/{userId} {
        allow read: if true;
        allow create: if true;
        allow update: if isSignedIn();
        allow delete: if isSignedIn();
      }
      
      // Products
      match /products/{productId} {
        allow read: if isAuthUserOfTenant(tenantId);
        allow create: if isAuthUserOfTenant(tenantId);
        allow update: if isAuthUserOfTenant(tenantId);
        allow delete: if isAuthUserOfTenant(tenantId);
        
        // Product Chat Subcollection
        match /chat/{messageId} {
          allow read: if isAuthUserOfTenant(tenantId);
          allow create: if isAuthUserOfTenant(tenantId) && request.resource.data.user_id == request.auth.uid;
          allow update: if isAuthUserOfTenant(tenantId) && resource.data.user_id == request.auth.uid;
          allow delete: if isAuthUserOfTenant(tenantId);
        }
      }
      
      // Quotas
      match /quotas/{quotaId} {
        allow read: if isAuthUserOfTenant(tenantId);
        allow create: if isAuthUserOfTenant(tenantId);
        allow update: if isAuthUserOfTenant(tenantId);
        allow delete: if isAuthUserOfTenant(tenantId);
        
        match /ownership_history/{historyId} {
          allow read: if isAuthUserOfTenant(tenantId);
          allow create, update, delete: if isAuthUserOfTenant(tenantId);
        }
      }
      
      // Installments
      match /installments/{installmentId} {
        allow read: if isAuthUserOfTenant(tenantId);
        allow create: if isAuthUserOfTenant(tenantId);
        allow update: if isAuthUserOfTenant(tenantId);
        allow delete: if isAuthUserOfTenant(tenantId);
      }
      
      // Audit Logs
      match /audit_logs/{logId} {
        allow read: if isAuthUserOfTenant(tenantId);
        allow create: if isAuthUserOfTenant(tenantId);
        allow update, delete: if false;
      }
      
      // Legal terms
      match /terms/{termId} {
        allow read: if true;
        allow write: if isAuthUserOfTenant(tenantId);
      }
      
      // Signatures & snapshots of closed products
      match /signatures/{signatureId} {
        allow read: if isAuthUserOfTenant(tenantId);
        allow create: if isAuthUserOfTenant(tenantId);
        allow update, delete: if false;
      }
      match /closing_snapshots/{snapshotId} {
        allow read: if isAuthUserOfTenant(tenantId);
        allow create: if isAuthUserOfTenant(tenantId);
        allow update, delete: if false;
      }
    }
  }
}
